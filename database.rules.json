{
  "rules": {
    "books": {
      ".read": true,
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "borrowRequests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth != null"
      }
    },
    "notes": {
      "$studentId": {
        ".read": "auth != null && (auth.uid === $studentId || auth.token.role === 'admin')",
        ".write": "auth != null && auth.uid === $studentId"
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.role === 'admin')",
        ".write": "auth != null && (auth.uid === $userId || auth.token.role === 'admin')"
      }
    }
  }
}
