rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      allow read: if true;
      allow write: if true;
    }
    match /borrowRequests/{requestId} {
      allow read: if true;
      allow write: if true;
    }
    match /notes/{noteId} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
